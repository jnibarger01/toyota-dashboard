# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string. Required in production; when unset locally
# the app falls back to an embedded PGLite database (see src/lib/db.ts).
# The MCP endpoint (/api/mcp) shares this same connection — see docs/mcp.md.
DATABASE_URL=

# Better Auth's own session-signing secret and this deployment's public
# origin. Required in production; auto-derived for local dev / live preview.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Native Better Auth Google social sign-in (server-only; never expose values to the browser).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical OAuth 2.1 protected-resource identifier for MCP. In production this
# must be the public HTTPS MCP URL, for example https://app.example.com/api/mcp.
MCP_RESOURCE_URL=
# Set to "false" to disable authentication (falls back to a single shared
# dev user — only safe with no DATABASE_URL. Leave unset/"true" everywhere
# a real database is configured.
VITE_AUTH_ENABLED=

# Optional: enables the OpenAI-backed AI shift-briefing and advisor drafting features.
OPENAI_API_KEY=

# --- MCP (docs/mcp.md) ------------------------------------------------------
# No dedicated env var: MCP bearer tokens (with explicit, least-privilege
# scopes) are minted directly into the database (tables `mcp_api_tokens` /
# `mcp_audit_log`, migrations 0010-0011) via:
#   DATABASE_URL=... node scripts/mint-mcp-token.mjs --user-id <id> --label "..." \
#     --scopes "toyota:read,toyota:ro:write,toyota:communication:write,toyota:followup:write,toyota:recommendation:write"
# There is nothing to set here for the MCP feature itself.
